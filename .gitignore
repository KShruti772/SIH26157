tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~
*.save
*.bak

# IDE / Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml

# Large / raw / generated datasets
data/raw/
data/downloads/
data/cache/
data/processed/
data/generated/
data/public/salad/
data/public/ai_soc/
data/public/*.csv
data/public/*.txt
data/public/*.parquet
data/public/*.json
data/public/*.zip
data/public/*.tar.gz

# Generated reports & outputs
reports/generated/
outputs/
artifacts/

# OS / archives
*.zip
*.tar
*.tar.gz
*.rar

# Docker
docker-data/
docker-volumes/

# Keep directory structure
!data/.gitkeep
!data/public/.gitkeep
!data/synthetic/.gitkeep
!models/.gitkeep
!docs/.gitkeep
!sample_data/.gitkeep
!notebooks/.gitkeep
!reports/.gitkeep