.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/
config/secrets.*

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-journal
backend/data/*.db

# ML / AI model files & weights (root models directory & binary weights)
/models/*
!/models/.gitkeep
checkpoints/
weights/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin

# Vector stores & embeddings
vectorstore/
vector_store/
embeddings/
.faiss/
